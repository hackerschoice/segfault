#! /usr/bin/env bash

# Run individual maintenance tasks, or use the Compose maintenance service.

SF_BASEDIR="${SF_BASEDIR:-/sf}"
SF_DATADIR="${SF_DATADIR:-${SF_BASEDIR}/data}"
SF_MV_EXIT_FN="${SF_DATADIR}/share/relay-exit-nodes-mullvad.txt"
SF_MV_RELAY_FN="${SF_DATADIR}/share/proxies.txt"
SF_HA_CONF="${SF_DATADIR}/share/haproxy-1040.conf"
SF_TOR_EXIT_FN="${SF_DATADIR}/share/tor-exit-nodes.txt"
SF_SHMDIR="${SF_SHMDIR:-/dev/shm/sf}"
export SF_BASEDIR SF_DATADIR SF_SHMDIR

# Bound Docker calls, including VPN proxy probes.
docker() { command timeout --kill-after=5 30 docker "$@"; }

[ "$PATH" != *"sbin" ] && PATH=/usr/sbin:/usr/local/sbin:$PATH

# SF_GLOBAL_EXIT_FN="/sf/config/etc/relay-exit-nodes-global.txt" # Provided by Blind Mouse
# aka curl -H "Auth: hAV2fDFN..." http://92.x.x.x:50613 >/sf/config/etc/relay-exit-nodes-global.txt

mk_haproxy1040_conf() {
    local fn
    fn=$(mktemp "${SF_DATADIR}/share/.haproxy-1040.XXXXXX") || return

    cat >"${fn}"<<-'EOF'
defaults
  timeout connect 15s
  timeout client 10s
  timeout server 60s

frontend socks-in
  mode tcp
  bind :1080
  default_backend socks-out

backend socks-out
  mode tcp
  default-server check observe layer4 error-limit 3 on-error mark-down inter 3600s downinter 60s rise 1
EOF
    shuf <"${SF_MV_RELAY_FN}" | while read -r str; do
        ips="$(dig +short "${str%:*}" | grep -v ^';;')" || continue
        [[ -z $ips ]] && continue
        echo "  server s${n} ${ips}:${str##*:} #$str"
        ((n++))
    done >>"${fn}"
    mv "${fn}" "${SF_HA_CONF}"
}

# Make a list of working proxies
# and exit mullvad proxy IPs.
mk_mullvad_relays()
{
    local IFS
    local str
    local arr
    local ip
    local ips
    local proxies

    [[ $(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' sf-mullvad 2>/dev/null) == healthy ]] ||
        { echo >&2 "Mullvad is not ready; keeping existing relay lists."; return 1; }

    IFS=""
    str=$(curl -fsSL --retry 3 --max-time 15 https://api.mullvad.net/www/relays/all/ 2>/dev/null | jq -r '.[] |  select(.socks_name != null) | select(.socks_port != null)  | "\(.socks_name):\(.socks_port)"' |grep -v ^-)
    str=${str//[^a-z0-9-:.$'\n']}
    [[ -z $str ]] && return 1

    IFS=$'\n'
    arr=($str)
    for h in "${arr[@]}"; do
        echo -n "Testing $h - "
        ip=$(docker exec sf-mullvad bash -c "curl --retry 1 --max-time 5 -fsSL -x 'socks5://$h'  ipinfo.io" | jq -r '.ip | select(. != null)')
        ip=${ip//[^a-f0-9:.]}
        [[ -z $ip ]] && { echo "SKIP"; continue; }
        echo "$ip"
        ips+="$ip"$'\n'
        proxies+="$h"$'\n'
    done
    [[ -n $proxies && -n $ips ]] || { echo >&2 "No working Mullvad proxies found; keeping existing relay lists."; return 1; }
    echo -n "$proxies" >"${SF_MV_RELAY_FN}"
    echo -n "$ips" >"${SF_MV_EXIT_FN}"
    mk_haproxy1040_conf
}

mk_tor_relays()
{
    local IFS
    local str
    IFS=""
    str=$(curl -SsfL --retry 3 --max-time 15 'https://www.dan.me.uk/torlist/?exit')
    [[ -z $str ]] && return 1
    printf '%s\n' "$str" >"${SF_TOR_EXIT_FN}"
}

