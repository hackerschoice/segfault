mk_geolite()
{
    local fn="GeoLite2-City.mmdb" stage
    [ -f "${SF_BASEDIR}/config/.env" ] && eval "$(grep ^MAX "${SF_BASEDIR}/config/.env")"
    [ -n "$MAXMIND_KEY" ] || return 0
    stage=$(mktemp -d "${SF_DATADIR}/share/.geolite.XXXXXX") || return
    if ! curl -fsSL --retry 3 --max-time 60 "https://download.maxmind.com/app/geoip_download?edition_id=GeoLite2-City&license_key=${MAXMIND_KEY}&suffix=tar.gz" |
        tar xfz - --strip-components=1 --no-anchored -C "$stage" "$fn"; then
        rm -rf "$stage"
        return 1
    fi
    chmod 644 "$stage/$fn" && mv "$stage/$fn" "${SF_DATADIR}/share/$fn"
    local ret=$?
    rm -rf "$stage"
    return "$ret"
}

purge_guests()
{
    source "${SF_BASEDIR}/sfbin/funcs_admin.sh" >/dev/null || return
    [[ -f "${SF_BASEDIR}/config/etc/sf/timers.conf" ]] &&
        source "${SF_BASEDIR}/config/etc/sf/timers.conf"
    lgpurge "${SF_TIMEOUT_IDLE_DAYS}" "${SF_TIMEOUT_NAUGHTY_DAY}"
}

stop_service()
{
    stopping=1
    if [[ -n ${worker_pid:-} ]]; then
        kill -TERM -- "-$worker_pid" 2>/dev/null
        wait "$worker_pid" 2>/dev/null
    fi
    [[ -n ${sleep_pid:-} ]] && kill "$sleep_pid" 2>/dev/null
}

daemon()
{
    local job last now interval result
    local -A due
    local -a jobs=(tor geolite purge)
    [[ -n $SF_MULLVAD_ENABLED ]] && jobs=(mullvad "${jobs[@]}")
    local relay_interval=${SF_MAINTENANCE_RELAY_INTERVAL:-86400}
    local purge_interval=${SF_MAINTENANCE_PURGE_INTERVAL:-604800}
    if [[ ! $relay_interval =~ ^[1-9][0-9]{0,8}$ || ! $purge_interval =~ ^[1-9][0-9]{0,8}$ ]]; then
        echo >&2 "Maintenance intervals must be positive seconds."
        return 2
    fi
    now=$(date -u +%s)
    # A new installation waits a full purge interval; restarts keep that deadline.
    [[ -f "$state_dir/last-purge" ]] || printf '%s\n' "$now" >"$state_dir/last-purge"
    for job in "${jobs[@]}"; do
        interval=$relay_interval
        [[ $job == purge ]] && interval=$purge_interval
        last=0
        [[ -f "$state_dir/last-$job" ]] && read -r last <"$state_dir/last-$job"
        [[ $last =~ ^[0-9]{1,10}$ ]] || { echo >&2 "Invalid maintenance timestamp: $job"; return 1; }
        due[$job]=$((last + interval))
    done
    stopping=0
    trap stop_service TERM INT
    echo "Maintenance service started."
    while [[ $stopping -eq 0 ]]; do
        now=$(date -u +%s)
        for job in "${jobs[@]}"; do
            [[ $stopping -eq 1 ]] && break
            [[ $now -lt ${due[$job]} ]] && continue
            setsid env SF_MAINTENANCE_WORKER=1 "$0" "$job" &
            worker_pid=$!
            wait "$worker_pid"
            result=$?
            unset worker_pid
            [[ $stopping -eq 1 ]] && break
            if [[ $result -eq 0 ]]; then
                interval=$relay_interval
                [[ $job == purge ]] && interval=$purge_interval
                now=$(date -u +%s)
                printf '%s\n' "$now" >"$state_dir/last-$job"
                due[$job]=$((now + interval))
                echo "Maintenance completed: $job"
            else
                due[$job]=$((now + 60))
                echo >&2 "Maintenance failed: $job; retrying in 60 seconds."
            fi
        done
        [[ $stopping -eq 1 ]] && break
        sleep 5 & sleep_pid=$!
        wait "$sleep_pid"
        unset sleep_pid
    done
    return 0
}

[[ $# -gt 0 ]] || { echo "Usage: $0 [mullvad, tor, geolite, purge, all, daemon]"; exit 2; }
for arg in "$@"; do
    case "$arg" in
        mullvad|tor|geolite|purge|all) ;;
        daemon) [[ $# -eq 1 ]] || { echo >&2 "daemon cannot be combined with tasks."; exit 2; } ;;
        *) echo >&2 "Unknown maintenance task: $arg"; exit 2 ;;
    esac
done
state_dir="${SF_DATADIR}/maintenance"
mkdir -p "$state_dir" "${SF_DATADIR}/share" || exit 1
if [[ -z $SF_MAINTENANCE_WORKER ]]; then
    exec 9>"$state_dir/maintenance.lock"
    flock -n 9 || { echo "Maintenance is already running; skipping duplicate invocation."; exit 0; }
fi
if [[ $1 == daemon ]]; then
    [[ -f "${SF_BASEDIR}/config/etc/sf/timers.conf" ]] &&
        source "${SF_BASEDIR}/config/etc/sf/timers.conf"
    daemon
    exit $?
fi

status=0
str=" $* "
if [[ $str == *" all "* ]]; then
    str=" mullvad tor geolite purge "
fi
[[ $str == *" mullvad "* ]] && { mk_mullvad_relays || status=$?; }
[[ $str == *" tor "* ]] && { mk_tor_relays || status=$?; }
[[ $str == *" geolite "* ]] && { mk_geolite || status=$?; }
[[ $str == *" purge "* ]] && { purge_guests || status=$?; }
# Preserve explicit all's historical log cleanup, never on a service restart.
if [[ " $* " == *" all "* ]]; then
    fn="${SF_SHMDIR}/run/logs/segfault.log"
    [[ ! -f $fn ]] || :>"$fn"
fi
exit "$status"
